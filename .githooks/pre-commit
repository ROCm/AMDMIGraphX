#!/bin/sh
#
# License-stamp the staged diff before the commit is created.
#
# Do not run clang-format here. The binary on PATH, including
# /opt/rocm/llvm/bin/clang-format, is not the one the CI format job runs.
# Formatting with it produces a diff that CI then rejects. .githooks/pre-push
# runs tools/format.py inside the CI image and is what blocks the push.

cd "$(git rev-parse --show-toplevel)" || exit 1

base="${MIGRAPHX_FORMAT_BASE:-origin/develop}"
if ! git rev-parse --verify "$base" >/dev/null 2>&1; then
    echo "pre-commit: $base is not available. Fetch it before committing." >&2
    exit 1
fi

python3 tools/check_stamped.py "$base" || exit 1
